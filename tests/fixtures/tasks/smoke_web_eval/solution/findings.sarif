                {
                  "locations": [
                    {
                      "location": {"physicalLocation": {"artifactLocation": {"uri": "src/calc_service/server.py"}, "region": {"startLine": 13, "endLine": 14}}},
                      "properties": {"role": "source"}
                    },
                    {
                      "location": {"physicalLocation": {"artifactLocation": {"uri": "src/calc_service/server.py"}, "region": {"startLine": 8, "endLine": 8}}},
