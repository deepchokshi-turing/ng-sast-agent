    "vocabulary": ["java"],
    "dockerfile": "java.Dockerfile",
    "skeleton": "java",
    "entrypoint": "java -cp build/classes app.App \"TODO sample request\"",
    "build_command": "javac -d build/classes $(find src/main/java -name '*.java')",
