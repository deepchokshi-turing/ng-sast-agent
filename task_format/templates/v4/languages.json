{
  "_about": "Per-language defaults used by tools/scaffold_pair.py. 'plan' lists the Language values of the plan workbook that map to the entry. 'vocabulary' is the task.toml languages value (it must also be listed in the dataset's vocabulary.json). Commands are repository-relative and run from /app/repo with no network. 'skeleton' is the folder under skeletons/ copied into environment/repo for purpose-built (type C) slots. Optional: 'repo_files' maps a repository path to a file under templates/v4/ that is copied into environment/repo for every slot kind (build helpers the commands rely on); 'dockerfile_note' fills @@RUNTIME_NOTE@@ in the Dockerfile template.",
  "python": {
    "plan": ["Python"],
    "vocabulary": ["python"],
    "dockerfile": "python.Dockerfile",
    "skeleton": "python",
    "entrypoint": "PYTHONPATH=src python -m app \"TODO sample request\"",
    "build_command": "python -m compileall -q src",
    "test_command": "python -m unittest discover -s tests -q",
    "scanner_roots": ["src", "config", "fixtures", "security_manifest.json", "pyproject.toml"],
    "excluded_paths": ["tests"],
    "repro_runner": "python:3.12-slim",
    "build_timeout_sec": 600.0,
    "memory_mb": 2048
  },
  "typescript": {
    "plan": ["TypeScript/JavaScript", "TypeScript"],
    "vocabulary": ["typescript"],
    "dockerfile": "node.Dockerfile",
    "dockerfile_note": "TypeScript: Node 24 runs the .ts sources directly (type stripping, erasable syntax only); the build\n# runs offline, so there are no npm installs: vendor what the code needs. `node --check` does not strip\n# types, so build_command type-strips and syntax-checks every source with scripts/check-syntax.mjs.",
    "skeleton": "typescript",
    "repo_files": {"scripts/check-syntax.mjs": "support/node/check-syntax.mjs"},
    "entrypoint": "node src/index.ts \"TODO sample request\"",
    "build_command": "node scripts/check-syntax.mjs src",
    "test_command": "node --test \"test/**/*.test.ts\"",
    "scanner_roots": ["src", "config", "fixtures", "security_manifest.json", "package.json"],
    "excluded_paths": ["test"],
    "repro_runner": "image",
    "build_timeout_sec": 900.0,
    "memory_mb": 2048
  },
