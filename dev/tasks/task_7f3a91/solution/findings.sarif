{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "oracle",
          "version": "gt-0.1",
          "rules": [
            {
              "id": "LLM02.SID.HIGH",
              "name": "SensitiveInformationDisclosureAcrossBoundary",
              "shortDescription": {"text": "Sensitive data reaches model context and crosses a trust boundary"},
              "properties": {"owasp": "LLM02:2026", "tags": ["security", "genai"]}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "LLM02.SID.HIGH",
          "level": "error",
          "message": {
            "text": "Ticket retrieval ignores the requesting user's tenant, so another tenant's confidential ticket bodies enter the prompt and are emailed to the requester.",
            "markdown": "`retrieve_context` calls `TicketStore.query` without `tenant_id`. A tenant-acme agent asking about refunds retrieves `GLBX-2001` (tenant-globex, PII, legal hold). The body is placed in the system prompt, echoed by the model, and delivered by `send_email`. Fix: pass `user.tenant_id` to the query; add a sink-side check that blocks email bodies carrying another tenant's data."
          },
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/retrieval.py"}, "region": {"startLine": 11, "endLine": 11}}}
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/store.py"}, "region": {"startLine": 20, "endLine": 22}}, "message": {"text": "All tenants' tickets loaded"}}, "properties": {"role": "source"}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/retrieval.py"}, "region": {"startLine": 11, "endLine": 11}}, "message": {"text": "query() without tenant_id"}}, "properties": {"role": "root_cause"}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/agent.py"}, "region": {"startLine": 30, "endLine": 30}}, "message": {"text": "Ticket bodies placed in system prompt"}}, "properties": {"role": "context_assembly"}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/agent.py"}, "region": {"startLine": 32, "endLine": 32}}, "message": {"text": "Prompt sent to model"}}, "properties": {"role": "model_consumption"}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/agent.py"}, "region": {"startLine": 35, "endLine": 41}}, "message": {"text": "Model-requested send_email dispatched with model-written body"}}, "properties": {"role": "model_decision"}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/support_copilot/tools.py"}, "region": {"startLine": 16, "endLine": 20}}, "message": {"text": "Delivered through outbound relay"}}, "properties": {"role": "sink"}}
                  ]
                }
              ]
            }
          ],
          "properties": {
            "cwe": ["CWE-359", "CWE-862"],
            "controlStatus": "none",
            "residualRisk": "high",
            "recommendations": ["REC-AUTHZ-BEFORE-RETRIEVAL", "REC-SINK-SIDE-IFC"]
          }
        }
      ]
    }
  ]
}
